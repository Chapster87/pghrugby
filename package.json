{
  "name": "pghrugby",
  "version": "1.0.0",
  "private": true,
  "description": "Pittsburgh Forge Rugby Club site — Next.js storefront on Stripe + DatoCMS + ForgeCMS",
  "scripts": {
    "dev": "next dev -p 8000",
    "build": "next build",
    "start": "next start -p 8000",
    "lint": "eslint .",
    "analyze": "ANALYZE=true next build",
    "generate-schema": "node ./scripts/generate-datocms-schema.mjs",
    "generate-typings": "pnpm gql-tada generate output",
    "provision:stripe": "node ./scripts/provision-stripe-catalog.mjs",
    "provision:stripe:apply": "node ./scripts/provision-stripe-catalog.mjs --apply",
    "scan:woocommerce": "node ./scripts/scan-woocommerce.mjs",
    "competition:extract": "node ./scripts/competition-migration/extract.mjs",
    "competition:reconcile": "node --env-file=.env.local scripts/competition-migration/reconcile.mjs",
    "competition:insert": "node --env-file=.env.local scripts/competition-migration/insert.mjs",
    "legacy-pages:cleanup": "node ./scripts/delete-legacy-datocms-pages.mjs",
    "supabase:query": "node --env-file=.env.local scripts/supabase-query.mjs",
    "supabase:inspect-forgecms": "node --env-file=.env.local scripts/inspect-forgecms.mjs",
    "prototype:datocms-models": "tsx src/lib/prototype-datocms-models/run.ts"
  },
